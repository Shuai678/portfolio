{
  "name": "nicolo-portfolio-analytics-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply ANALYTICS_DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply ANALYTICS_DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "4.123.0"
  }
}
