{
  "name": "nicolo-shuai-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.ts --host 127.0.0.1 --port 4174",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && vite build --config vite.admin.config.ts",
    "build:all": "npm run build && npm run build:admin",
    "preview": "vite preview",
    "analytics:check": "npm --prefix analytics run check",
    "analytics:dev": "npm run build:admin && npm --prefix analytics run dev",
    "analytics:deploy": "npm run build:admin && npm --prefix analytics run deploy"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
